      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1698111680,
      "version": 1,
      "versionNonce": 1589702040,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "CONTAS  (conta dev do Davi)\n\n• GitHub: odavicandidof (mesma conta)\n• Vercel: projeto + cron + env vars\n• Google Cloud: Sheets API\n  + SA sheets-writer (sem chave)\n• Google Sheets: planilha prod + teste",
      "originalText": "CONTAS  (conta dev do Davi)\n\n• GitHub: odavicandidof (mesma conta)\n• Vercel: projeto + cron + env vars\n• Google Cloud: Sheets API\n  + SA sheets-writer (sem chave)\n• Google Sheets: planilha prod + teste",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle_52",
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 16
    },
