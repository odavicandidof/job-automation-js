      "seed": 703026131,
      "version": 1,
      "versionNonce": 694279530,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "CONTAS  (conta dev do Davi)\n\n• GitHub: odavicandidof (mesma conta)\n• Vercel: projeto + cron + env vars\n• Google Cloud: Sheets API\n  + Service Account\n• Google Sheets: planilha prod + teste",
      "originalText": "CONTAS  (conta dev do Davi)\n\n• GitHub: odavicandidof (mesma conta)\n• Vercel: projeto + cron + env vars\n• Google Cloud: Sheets API\n  + Service Account\n• Google Sheets: planilha prod + teste",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle_52",
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 16
    },
    {
      "id": "rectangle_54",
