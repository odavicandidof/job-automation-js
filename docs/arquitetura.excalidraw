      "versionNonce": 621538350,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ENV VARS  (só no servidor)\n\nGOOGLE_SERVICE_ACCOUNT_JSON\nSHEETS_ID  ·  SHEETS_ID_TEST\nCRON_SECRET  ·  SESSION_SECRET\nADMIN_PASSWORD_HASH\n(local: node --env-file=.env)",
      "originalText": "ENV VARS  (só no servidor)\n\nGOOGLE_SERVICE_ACCOUNT_JSON\nSHEETS_ID  ·  SHEETS_ID_TEST\nCRON_SECRET  ·  SESSION_SECRET\nADMIN_PASSWORD_HASH\n(local: node --env-file=.env)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle_54",
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 16
