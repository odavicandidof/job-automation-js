      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ENV VARS  (só no servidor)\n\nSHEETS_ID  ·  SHEETS_ID_TEST\nCRON_SECRET  ·  SESSION_SECRET\nADMIN_PASSWORD_HASH\nGoogle: SEM chave JSON\n(local: gcloud · Vercel: OIDC)",
      "originalText": "ENV VARS  (só no servidor)\n\nSHEETS_ID  ·  SHEETS_ID_TEST\nCRON_SECRET  ·  SESSION_SECRET\nADMIN_PASSWORD_HASH\nGoogle: SEM chave JSON\n(local: gcloud · Vercel: OIDC)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
